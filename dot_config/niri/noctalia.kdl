layout {

    focus-ring {
        active-color   "#d3ca52"
        inactive-color "#0c160e"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#d3ca52"
        inactive-color "#0c160e"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#d3ca52"
        inactive-color "#4d4800"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#d3ca5280"
    }
}

recent-windows {
    highlight {
        active-color "#d3ca52"
        urgent-color "#ffb4ab"
    }
}
