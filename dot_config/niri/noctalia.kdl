layout {

    focus-ring {
        active-color   "#bec6de"
        inactive-color "#131315"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#bec6de"
        inactive-color "#131315"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#bec6de"
        inactive-color "#394154"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#bec6de80"
    }
}

recent-windows {
    highlight {
        active-color "#bec6de"
        urgent-color "#ffb4ab"
    }
}
