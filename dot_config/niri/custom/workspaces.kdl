spawn-at-startup "thunderbird";
spawn-at-startup "solaar";

workspace "browser" {
  open-on-output "DP-1";
}
workspace "development"{
  open-on-output "DP-1";
}
workspace "email"{
  open-on-output "DP-1";
}
workspace "chats"{
  open-on-output "DP-1";
}

window-rule {
  match app-id="Slack";
  open-on-workspace "chats";
};

window-rule {
  match app-id="Thunderbird";
  open-on-workspace "email";
};

